# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANALYSIS_MODEL=claude-opus-4-7

# Database
DATABASE_URL=sqlite:///./auctions.db

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=app_password_here
SMTP_FROM=tu_email@gmail.com
SMTP_TO=destinatario@example.com
SMTP_USE_TLS=true

# Targeting (Catalonia provinces: 08=Barcelona, 17=Girona, 25=Lleida, 43=Tarragona)
TARGET_PROVINCES=08,17,25,43
MAX_PRICE_EUR=400000
MIN_OPPORTUNITY_SCORE=60

# Scheduler
DAILY_RUN_HOUR=8
DAILY_RUN_MINUTE=0
TIMEZONE=Europe/Madrid

# Scraping
HTTP_TIMEOUT_SECONDS=30
HTTP_USER_AGENT=Mozilla/5.0 (compatible; AuctionAnalyzer/1.0)
ENABLED_SCRAPERS=boe,addmeet,idealista,solvia,haya,servihabitat,aliseda
