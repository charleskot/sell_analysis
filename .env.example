# ── Residential Proxy (required for Fotocasa & Idealista) ──────────────────
#
# Format: http://user:pass@host:port  or  socks5://user:pass@host:port
#
# Providers:
#   Bright Data  → https://brightdata.com          ~$8.4/GB  (best quality)
#   Oxylabs      → https://oxylabs.io              ~$8/GB
#   Smartproxy   → https://smartproxy.com          ~$7/GB
#   IPRoyal      → https://iproyal.com             ~$3/GB    (budget)
#
# Bright Data example (residential, Spain targeting):
#   SCRAPER_PROXY=http://brd-customer-XXXXXXXX-zone-residential-country-es:PASSWORD@brd.superproxy.io:22225
#
# Smartproxy example:
#   SCRAPER_PROXY=http://user.es:PASSWORD@gate.smartproxy.com:7000
#
SCRAPER_PROXY=

# ── Telegram Alerts ─────────────────────────────────────────────────────────
# Get token from @BotFather, chat_id from @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Panel de recobros: integraciones ────────────────────────────────────────
# HubSpot (CRM API v3): token privado de la app. Reutilizar el del proyecto bihsales.
HUBSPOT_TOKEN=
# Nombre interno de la propiedad de contacto donde se escribe el estado de morosidad.
HUBSPOT_PROP_MOROSIDAD=estado_recobro
#
# WooCommerce (REST API v3): claves de la tienda. Reutilizar las del proyecto bihsales.
WOO_URL=
WOO_KEY=
WOO_SECRET=
